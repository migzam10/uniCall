# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real al repositorio.

# --- Aplicación ---
APP_NAME="LSC Videollamadas Accesibles"
ENVIRONMENT=development
DEBUG=true
APP_BASE_URL=http://localhost:8000

# --- Base de datos ---
# Para desarrollo local con Docker Compose (ver infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://lsc_user:lsc_password@localhost:5432/lsc_db

# --- Seguridad / JWT ---
# Genera uno propio, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- TURN/STUN (para fases posteriores de WebRTC) ---
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# --- IA de voz (Fase 3) ---
# "mock" (por defecto): no requiere descargas, útil para desarrollo/pruebas.
# "whisper": motor real, descarga el modelo la primera vez (requiere internet).
STT_ENGINE=mock

# --- Reconocimiento de LSC (Fase 5) ---
# Distancia DTW máxima para aceptar una coincidencia. Valor de partida;
# ajustar empíricamente con datos reales (ver README, sección Fase 5).
LSC_MAX_DTW_DISTANCE=15.0
